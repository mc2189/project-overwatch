# Project Overwatch — local environment settings (placeholders only)
# Copy to .env and fill in real values locally. Never commit .env to Git.
#
#   cp .env.example .env

# --- API keys (optional until modules are implemented) ---
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
GREYNOISE_API_KEY=your_greynoise_api_key_here
SHODAN_API_KEY=your_shodan_api_key_here
ABUSECH_AUTH_KEY=your_abusech_auth_key_here
URLHAUS_AUTH_KEY=your_urlhaus_auth_key_here
CENSYS_API_ID=your_censys_api_id_here
CENSYS_API_SECRET=your_censys_api_secret_here
SECURITYTRAILS_API_KEY=your_securitytrails_api_key_here
HUNTER_API_KEY=your_hunter_api_key_here
HAVEIBEENPWNED_API_KEY=your_hibp_api_key_here

# --- General settings (optional — safe defaults apply if unset) ---
PROJECT_OVERWATCH_RATE_LIMIT_SECONDS=1.5
PROJECT_OVERWATCH_DEFAULT_TIMEOUT=30
PROJECT_OVERWATCH_MAX_BATCH_ITEMS=50
PROJECT_OVERWATCH_ENABLE_ACTIVE_MODULES=true
PROJECT_OVERWATCH_PERSONAL_LAB_ENABLED=true
PROJECT_OVERWATCH_PERSONAL_LAB_PRIVATE_QUICK_SCOPE=true
# Assessment playbooks / autopilot (v2.32)
# PROJECT_OVERWATCH_DEFAULT_ASSESSMENT_MODE=assisted
# PROJECT_OVERWATCH_ENABLE_PASSIVE_AUTOPILOT=false
# PROJECT_OVERWATCH_ENABLE_PERSONAL_LAB_AUTOPILOT=false
# PROJECT_OVERWATCH_MAX_PLAYBOOK_STEPS=10
# PROJECT_OVERWATCH_MAX_ACTIVE_CHECKS=3
# PROJECT_OVERWATCH_MAX_PASSIVE_CHECKS=8
# PROJECT_OVERWATCH_RDAP_CACHE_TTL_HOURS=168
# PROJECT_OVERWATCH_LOCAL_ENCRYPTION_KEY=your_fernet_key_here

# --- Optional local app password (alternative to .streamlit/secrets.toml) ---
# OVERWATCH_APP_PASSWORD=your-local-password
